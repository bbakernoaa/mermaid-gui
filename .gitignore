# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
develop-eggs/
sdist/
wheels/
pip-wheel-metadata/

# ── Virtual environments ────────────────────────────────
.venv/
venv/
env/
ENV/
envoy/
.conda/
micromamba/

# ── Test / lint / coverage ──────────────────────────────
.pytest_cache/
.pytest_vac/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
report.xml
.mypy_cache/
.pytype/
.ruff_cache/
.cache/
nosetests.xml

# ── Streamlit / app data ────────────────────────────────
.streamlit/secrets.toml
.session-sessions/
*.sqlite
*.db

# ── Jupyter ─────────────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ── Node (dev-only test tooling; never part of the Pages upload) ─
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# package-lock.json is deliberately NOT ignored: CI runs `npm ci`, which requires
# it, and pinning @playwright/test is what keeps the browser contracts reproducible.
.pnpm-store/

# ── Editors / IDEs ──────────────────────────────────────
.vscode/
!.vscode/settings.sample.json
!.vscode/extensions.json
.idea/
*.iml
*.sublime-project
*.sublime-workspace
.emmet.json
.nova/
*.swp
*.swo
*~

# ── OS cruft ────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ── Logs / temp / backups ───────────────────────────────
logs/
*.log
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej
.crashlog/

# ── Env files / secrets ─────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
# Dev-only browser fixtures: regenerated by tests/build_fixture.py before every
# Playwright run, never committed.
tests/.generated/
test-results/
playwright-report/
